# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

# ─── Database (Neon.tech or local Postgres) ────────────────────────────────────
DATABASE_URL=postgresql://stashpot:password@localhost:5432/stashpot

# ─── Redis (Upstash or local) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Solana ───────────────────────────────────────────────────────────────────
SOLANA_NETWORK=devnet
# Devnet:  https://api.devnet.solana.com
# Mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.devnet.solana.com

# USDC Mint
# Devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Program IDs (update after anchor deploy)
YIELD_VAULT_PROGRAM_ID=YVLTx1111111111111111111111111111111111111
PRIZE_MODULE_PROGRAM_ID=PRZMx1111111111111111111111111111111111111
INHERITANCE_PROGRAM_ID=INHRx1111111111111111111111111111111111111
SAVINGS_CIRCLES_PROGRAM_ID=CRCLx1111111111111111111111111111111111111
MICROLOANS_PROGRAM_ID=MLONx1111111111111111111111111111111111111
GOVERNANCE_PROGRAM_ID=GOVTx1111111111111111111111111111111111111

# Admin keypair (base58 encoded, use for automation only)
# NEVER commit the actual value — keep in secrets manager
ADMIN_KEYPAIR_PATH=~/.config/solana/stashpot-admin.json

# ─── Fiat On-Ramps ────────────────────────────────────────────────────────────
# Yellow Card (Africa — NGN/GHS/KES/ZAR)
# Sign up: https://business.yellowcard.io
YELLOW_CARD_API_KEY=your_yellowcard_api_key
YELLOW_CARD_API_SECRET=your_yellowcard_api_secret
YELLOW_CARD_WEBHOOK_SECRET=your_yellowcard_webhook_secret
YELLOW_CARD_ENV=sandbox   # change to "production" for mainnet

# Transak (Global fallback)
# Sign up: https://partner.transak.com
TRANSAK_API_KEY=your_transak_api_key
TRANSAK_API_SECRET=your_transak_api_secret
TRANSAK_WEBHOOK_SECRET=your_transak_webhook_secret
TRANSAK_ENV=staging   # change to "production" for mainnet

# ─── Notifications ────────────────────────────────────────────────────────────
# Firebase Cloud Messaging
# Project: https://console.firebase.google.com
FIREBASE_PROJECT_ID=your_firebase_project_id
# Minify the service account JSON to a single line:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_your_resend_key

# ─── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_VAULT=true
FEATURE_DEPOSITS=true
FEATURE_WITHDRAWALS=true
FEATURE_PRIZE_POOLS=true
FEATURE_INHERITANCE=true
FEATURE_CIRCLES=true
FEATURE_LOANS=false       # off until audit passes
FEATURE_REFERRALS=true
FEATURE_FIAT=true
FEATURE_CARDS=false       # off until card partner ready

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated if multiple origins
FRONTEND_URL=http://localhost:3000

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
